(module
  (type $entry (func (param i32) (result i32)))
  (import "env" "memory" (memory 1 1 shared))
  (import "env" "table" (table 8 8 funcref))
  ;; Emitter-owned addresses; the loader reads these from the final binary.
  (global (export "process_word") i32 (i32.const 32))
  (global (export "generation_word") i32 (i32.const 48))
  (global (export "data_base") i32 (i32.const 64))
  (global (export "data_size") i32 (i32.const 16))
  (global (export "bss_base") i32 (i32.const 128))
  (global (export "bss_size") i32 (i32.const 64))
  (global (export "code_record") i32 (i32.const 224))
  (global (export "worker_base") i32 (i32.const 4096))
  (global (export "worker_stride") i32 (i32.const 512))
  (global (export "worker_count") i32 (i32.const 4))
  (global (export "tls_offset") i32 (i32.const 0))
  (global (export "tls_size") i32 (i32.const 16))
  (global (export "tcr_offset") i32 (i32.const 32))
  (global (export "tcr_size") i32 (i32.const 64))
  (global (export "cstack_offset") i32 (i32.const 128))
  (global (export "cstack_size") i32 (i32.const 128))
  (global (export "vstack_offset") i32 (i32.const 288))
  (global (export "vstack_size") i32 (i32.const 128))
  (global (export "heap_base") i32 (i32.const 8192))
  (global (export "heap_size") i32 (i32.const 1024))
  (global (export "staging_base") i32 (i32.const 12288))
  (global (export "staging_size") i32 (i32.const 512))
  (global $owner (export "owner") (mut i32) (i32.const -1))
  (global $tls (export "tls") (mut i32) (i32.const 0))
  (global $tcr (export "tcr") (mut i32) (i32.const 0))
  (global $csp (export "csp") (mut i32) (i32.const 0))
  (global $vsp (export "vsp") (mut i32) (i32.const 0))
  (data $initial "\01\23\45\67\89\ab\cd\ef\10\32\54\76\98\ba\dc\fe")
  (func $reserved (type $entry) (param $x i32) (result i32)
    (i32.add (local.get $x) (i32.const 17)))
  (elem (i32.const 1) $reserved)
  ;; No start function: instance creation has no linear-memory write authority.
  (func (export "process_once") (result i32)
    (if (i32.ne (i32.atomic.rmw.cmpxchg (i32.const 32) (i32.const 0) (i32.const 1)) (i32.const 0))
      (then (return (i32.const 0))))
    (memory.init $initial (i32.const 64) (i32.const 0) (i32.const 16))
    (memory.fill (i32.const 128) (i32.const 0) (i32.const 64))
    (i32.atomic.store (i32.const 32) (i32.const 2))
    (i32.const 1))
  (func (export "setup") (param $id i32) (param $base i32) (result i32)
    (if (i32.or (i32.ge_u (local.get $id) (i32.const 4))
                (i32.ne (local.get $base) (i32.add (i32.const 4096) (i32.mul (local.get $id) (i32.const 512)))))
      (then (return (i32.const 1))))
    (if (i32.or (i32.ne (global.get $owner) (i32.const -1))
                (i32.ne (i32.atomic.load (i32.const 32)) (i32.const 2)))
      (then (return (i32.const 2))))
    ;; These four ranges belong only to this leased Worker. Gaps stay untouched.
    (memory.fill (local.get $base) (i32.const 0) (i32.const 16))
    (memory.fill (i32.add (local.get $base) (i32.const 32)) (i32.const 0) (i32.const 64))
    (memory.fill (i32.add (local.get $base) (i32.const 128)) (i32.add (i32.const 160) (local.get $id)) (i32.const 128))
    (memory.fill (i32.add (local.get $base) (i32.const 288)) (i32.add (i32.const 176) (local.get $id)) (i32.const 128))
    (i32.store (local.get $base) (i32.add (local.get $id) (i32.const 1000)))
    (global.set $owner (local.get $id))
    (global.set $tls (local.get $base))
    (global.set $tcr (i32.add (local.get $base) (i32.const 32)))
    (global.set $csp (i32.add (local.get $base) (i32.const 256)))
    (global.set $vsp (i32.add (local.get $base) (i32.const 416)))
    (i32.store (global.get $tcr) (i32.add (local.get $id) (i32.const 1)))
    (i32.store offset=4 (global.get $tcr) (global.get $tls))
    (i32.store offset=8 (global.get $tcr) (global.get $csp))
    (i32.store offset=12 (global.get $tcr) (global.get $vsp))
    (i32.const 0))
  (func (export "touch_private") (param $token i32)
    (i32.store offset=12 (global.get $tls) (local.get $token))
    (i32.store offset=60 (global.get $tcr) (local.get $token))
    (i32.store (i32.sub (global.get $csp) (i32.const 4)) (local.get $token))
    (i32.store (i32.sub (global.get $vsp) (i32.const 4)) (local.get $token)))
  (func (export "touch_shared") (param $round i32)
    (memory.fill (i32.const 64) (i32.add (i32.const 208) (local.get $round)) (i32.const 16))
    (memory.fill (i32.const 128) (i32.add (i32.const 177) (local.get $round)) (i32.const 64))
    (memory.fill (i32.const 8192) (i32.add (i32.const 226) (local.get $round)) (i32.const 1024))
    (memory.fill (i32.const 12288) (i32.add (i32.const 243) (local.get $round)) (i32.const 512)))
)
