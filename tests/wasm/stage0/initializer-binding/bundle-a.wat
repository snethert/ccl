;; Definitions bundle A: symbols (ordinal 3) and readers (ordinal 4).
(module
  (import "env" "memory" (memory 2 2))
  (import "loader" "note" (func $note (param i32)))
  (import "loader" "complete" (func $complete (param i32 i32)))
  (import "loader" "completed" (func $completed (param i32) (result i32)))
  (func $require (param $ordinal i32) (param $expected i32) (result i32) (i32.eq (call $completed (local.get $ordinal)) (local.get $expected)))
  (func (export "init_symbols") (result i32)
    (if (i32.eqz (i32.and (i32.and (call $require (i32.const 0) (i32.const 19777)) (call $require (i32.const 1) (i32.const 17473))) (call $require (i32.const 2) (i32.const 18771))))
      (then (call $note (i32.const 903)) (return (i32.const -1))))
    (call $note (i32.const 103))
    (i32.store (i32.const 8192) (i32.const 4))
    (i32.store (i32.const 8196) (i32.const 1850)) (i32.store (i32.const 8200) (i32.const 1850)) (i32.store (i32.const 8204) (i32.const 1850)) (i32.store (i32.const 8208) (i32.const 1850))
    (call $complete (i32.const 3) (i32.const 21337))
    (i32.const 21337))
  (func (export "init_readers") (result i32)
    (if (i32.eqz (call $require (i32.const 3) (i32.const 21337))) (then (call $note (i32.const 904)) (return (i32.const -1))))
    (call $note (i32.const 104))
    (i32.store (i32.const 8448) (i32.const 2)) (i32.store (i32.const 8452) (i32.const 8196)) (i32.store (i32.const 8456) (i32.const 8200))
    (call $complete (i32.const 4) (i32.const 21060))
    (i32.const 21060)))
