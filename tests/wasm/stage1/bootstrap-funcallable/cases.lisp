(in-package :wasm32-compiler)

(load (merge-pathnames "witnesses.lisp" *load-pathname*))
(load (merge-pathnames "inputs.lisp" *load-pathname*))

(defvar *funcallable-inputs* (make-hash-table :test #'eq))

(defun funcallable-input (value)
  (let ((gf (make-instance 'standard-generic-function :name 'funcallable-witness)))
    (setf (ccl::%svref (ccl::gf.slots gf) 1) value
          (ccl::%svref (ccl::gf.slots gf) 2) (list value)
          (ccl::%svref (ccl::gf.slots gf) 3) (vector value))
    (setf (gethash gf *funcallable-inputs*) t)
    gf))

