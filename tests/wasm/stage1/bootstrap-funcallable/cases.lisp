(defvar *funcallable-deferred-inputs* nil)

(defun core-inputs (name)
  ;; Old speculative class-cell recipes did not run while their dependencies
  ;; were missing. A closed call graph does not make NIL a native class cell.
  (when (and (find name *core-records* :key #'second)
             (equal (first (find name *core-records* :key #'second)) "ccl:level-1;l1-clos-boot.lisp")
             (not (member (symbol-name name) *funcallable-prior-executions* :test #'equal))
             (not (member name '(ccl::%generic-function-name
                                 ccl::%generic-function-method-combination
                                 ccl::%generic-function-method-class))))
    (pushnew name *funcallable-deferred-inputs*)
    (return-from core-inputs (values nil nil)))
  (multiple-value-bind (members present) (witness-inputs name)
    (multiple-value-bind (previous covered) (prior-inputs name)
(multiple-value-bind (new tested) (more-inputs name)
        (values (append members previous new) (or present covered tested))))))
