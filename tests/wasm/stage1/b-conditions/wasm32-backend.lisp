(defun b-variable-address (var)
  (let* ((root (ccl::nx-root-var var)) (n (position root *required-vars* :test #'eq)))
    (cond ((b-captured-p root) (b-at (b-cell-reference root) 3))
          ((member root *b-bound-vars* :test #'eq) (b-bound-address root))
