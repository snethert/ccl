             (let ((mode :required))
               (mapcar (lambda (item)
                         (cond ((member item '(&optional &key &rest &allow-other-keys))
                                (setf mode item) item)
                               ((and (member mode '(&optional &key)) (consp item))
                                (if (cdr item)
                                  (cons (first item) (cons (walk (second item)) (cddr item))) item))
                               (t item))) items)))
