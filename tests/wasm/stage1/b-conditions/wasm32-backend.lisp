   (local.set $tail (i32.load (call $handler_cons (local.get $x))))
   (if (result i32) (i32.eq (local.get $tail) (i32.const 77825)) (then (i32.const 77825)) (else (i32.load offset=4 (call $handler_cons (local.get $tail))))))
