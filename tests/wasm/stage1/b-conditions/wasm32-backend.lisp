     (i32.or (i32.or (i32.eq (local.get $mask) (i32.const 31)) (i32.eq (local.get $mask) (i32.const 39)))
             (i32.or (i32.eq (local.get $mask) (i32.const 71)) (i32.eq (local.get $mask) (i32.const 393)))))) (then (throw $call_error (i32.const 5))))
