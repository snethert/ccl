      ((equal s "TRUNCATING-STRING-OUTPUT-STREAM-IOBLOCK-WRITE-CHAR")
       (values (loop for (text index char) in '(("...." 0 #\a) ("...." 2 #\Newline)
                                               ("...." 3 #\λ) ("...." 4 #\z) ("" 0 #\a))
                     collect (list (recipe-output text index) char)) t))
      ((equal s "TRUNCATING-STRING-OUTPUT-STREAM-IOBLOCK-WRITE-SIMPLE-STRING")
