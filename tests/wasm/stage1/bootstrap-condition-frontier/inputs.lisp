                 (((ccl::recipe-a . (1 . 2)) (ccl::recipe-b . nil)))
                 (((ccl::recipe-a . 7) (ccl::recipe-a . 9)))) t))
      ((equal s "TRUNCATING-STRING-OUTPUT-STREAM-TRUNCATED-P")
       (values (loop for info in '(nil (:truncated nil) (:truncated t) (:x 7 :truncated t))
