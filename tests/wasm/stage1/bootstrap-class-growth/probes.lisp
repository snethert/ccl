    (defun core-condition-rebuild-cells (image)
      (core-condition-prepare image)
      (let ((ccl::%find-classes% (svref image 3)) (count 0) (fresh t))
        (dolist (entry (svref image 11))
          (let ((old (ccl::find-class-cell (car entry) nil))
                (cell (ccl::make-class-cell (car entry))))
            (setf (ccl::class-cell-class cell) (cdr entry)
                  (gethash (car entry) ccl::%find-classes%) cell)
            (unless (and (not (eq old cell))
                         (eq (ccl::find-class-cell (car entry) nil) cell))
              (setq fresh nil))
            (incf count)))
        (core-collect)
        (dolist (entry (svref image 11))
          (unless (eq (find-class (car entry)) (cdr entry)) (setq fresh nil)))
        (let ((condition (make-condition 'cpl-derived)))
          (values fresh count (slot-value condition 'payload)
                  (slot-value condition 'other)))))

