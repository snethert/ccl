    (defun core-condition-table-grow (image)
      (core-condition-prepare image)
      (let* ((ccl::%find-classes% (svref image 3))
             (names (svref image 10))
             (class (find-class 'cpl-derived))
             (count 0) (good t))
        (dolist (name names)
          (let ((cell (ccl::find-class-cell name t)))
            (setf (ccl::class-cell-class cell) class)
            (incf count)
            (when (zerop (logand count 127)) (core-collect))))
        (core-collect)
        (dolist (name names)
          (unless (eq (find-class name) class) (setq good nil)))
        ;; Remove across the enlarged vector, collect with tombstones, restore.
        (dolist (name names)
          (unless (remhash name ccl::%find-classes%) (setq good nil)))
        (core-collect)
        (dolist (name names)
          (when (remhash name ccl::%find-classes%) (setq good nil))
          (setf (ccl::class-cell-class (ccl::find-class-cell name t)) class))
        (core-collect)
        (dolist (name names)
          (unless (eq (find-class name) class) (setq good nil)))
        (let ((condition (make-condition (find-class (car names)))))
          (values good count (slot-value condition 'payload)
                  (slot-value condition 'other)))))

