    (defun core-condition-own-table (image)
      (core-condition-prepare image)
      (let* ((original (svref image 3))
             (ccl::%find-classes% (ccl::%wasm-make-class-table 4))
             (good t) (count 0))
        ;; Start without a projected vector or cell. The source class objects
        ;; supply identities; everything holding them here is target allocated.
        (dolist (entry (svref image 11))
          (let ((cell (ccl::find-class-cell (car entry) t)))
            (setf (ccl::class-cell-class cell) (cdr entry))
            (incf count)
            (when (zerop (logand count 63)) (core-collect))))
        (setf (svref image 3) ccl::%find-classes%)
        (core-collect)
        (dolist (entry (svref image 11))
          (unless (and (eq (find-class (car entry)) (cdr entry))
                       (not (eq (gethash (car entry) original)
                                (gethash (car entry) ccl::%find-classes%))))
            (setq good nil)))
        (let* ((name (ccl::class-cell-name (gethash 'cpl-left original)))
               (cell (ccl::find-class-cell name nil)))
          (unless (remhash name ccl::%find-classes%) (setq good nil))
          (core-collect)
          (when (find-class name nil) (setq good nil))
          (setf (gethash name ccl::%find-classes%) cell))
        (core-collect)
        (let ((condition (make-condition 'cpl-derived)))
          (values good count (slot-value condition 'payload)
                  (slot-value condition 'other)))))

