(in-package "CCL")
(eval-when (:compile-toplevel :execute)
  (require "HASHENV" "ccl:xdump;hashenv"))

(defmacro loader-with-buffer ((buffer size) &body body)
  #+wasm32-target `(let ((,buffer (make-array ,size :element-type '(unsigned-byte 8) :initial-element 0))) ,@body)
  #-wasm32-target `(let ((,buffer (%new-ptr ,size)))
                    (unwind-protect (progn ,@body) (free ,buffer))))

(defun loader-io-roundtrip (kind)
  (let* ((text (case kind
                 (0 "") (1 "hello") (2 "éλ漢") (t "A😀𝄞Z")))
         (n (utf-8-octets-in-string text 0 (length text)))
         (target (make-string (length text))))
    (loader-with-buffer (buffer (+ n 4))
      (let ((end (utf-8-memory-encode text buffer 2 0 (length text))))
        (values n end (utf-8-length-of-memory-encoding buffer n 2)
                (utf-8-memory-decode buffer n 2 target) target
                (utf-16-octets-in-string text 0 (length text)))))))

(defun loader-io-words ()
  (loader-with-buffer (buffer 24)
    (%set-unsigned-byte buffer 0 255)
    (%set-unsigned-word buffer 1 65535)
    (%set-unsigned-long buffer 3 #xfedcba98)
    (%set-byte buffer 8 -128)
    (%set-word buffer 9 -32768)
    (%set-long buffer 11 -2147483648)
    (values (%get-unsigned-byte buffer 0) (%get-signed-byte buffer 0)
            (%get-unsigned-word buffer 1) (%get-signed-word buffer 1)
            (%get-unsigned-long buffer 3) (%get-signed-long buffer 3)
            (%get-signed-byte buffer 8) (%get-signed-word buffer 9)
            (%get-signed-long buffer 11))))

(defun loader-io-utf16 ()
  (loader-with-buffer (buffer 12)
    (values (native-utf-16-memory-encode "A😀Z" buffer 0 0 3)
            (%get-unsigned-word buffer 0) (%get-unsigned-word buffer 2)
            (%get-unsigned-word buffer 4) (%get-unsigned-word buffer 6))))

(defun loader-hash-vector (size)
  (let* ((vector (%cons-nhash-vector size))
         (key (list 41)) (value (list 97)))
    (let ((empty (and (eq (%svref vector 14) (%unbound-marker))
                      (eq (%svref vector 15) (%unbound-marker)))))
      (%set-hash-table-vector-key vector 14 key)
      (setf (%svref vector 15) value (nhash.vector.count vector) 1)
      (let ((pressure (make-list 1600 :initial-element 3)))
        (values (uvsize vector) (nhash.vector.size vector) empty
                (eq key (%svref vector 14)) (car (%svref vector 14))
                (car (%svref vector 15)) (length pressure))))))

(defun loader-hash-table ()
  (let ((table (funcall (symbol-function 'make-hash-table)
                       :test 'eq :size 40 :shared t :lock-free nil)))
    (funcall (symbol-function 'puthash) 23 table 101)
    (funcall (symbol-function 'puthash) 41 table 202)
    (multiple-value-bind (value present) (funcall (symbol-function 'gethash) 23 table)
      (values value present (funcall (symbol-function 'hash-table-count) table)
              (funcall (symbol-function 'remhash) 41 table)
              (funcall (symbol-function 'gethash) 41 table -1)))))

(defun loader-misc-sequences ()
  (let ((buffer (make-array 4 :element-type '(unsigned-byte 8) :initial-element 0))
        (text (make-string 4)))
    (%copy-string-to-u8 "Abcd" 0 buffer 0 4)
    (%copy-u8-to-string buffer 0 text 0 4)
    (values text (proper-list-p '(1 2 3)) (list-length '(1 2 3))
            (append-2 '(1 2) '(3 4)))))

(defvar *loader-buffer-cleanup* 0)
(defun loader-buffer-refusal (kind)
  (unwind-protect
       (let ((buffer (make-array 4 :element-type '(unsigned-byte 8) :initial-element 17)))
         (case kind
           (0 (%get-unsigned-byte buffer -1))
           (1 (%get-unsigned-word buffer 3))
           (2 (%get-unsigned-long buffer 1))
           (3 (%get-unsigned-byte (vector 0 0) 0))
           (4 (%set-unsigned-byte buffer 0 256))
           (5 (%set-word buffer 0 32768))
           (6 (%get-unsigned-byte buffer nil))
           (7 (%alloc-misc 15 target::subtag-hash-vector (%unbound-marker)))
           (8 (%alloc-misc 16 target::subtag-hash-vector (if (= kind 8) nil (%unbound-marker))))
           (9 (%cons-nhash-vector 31 (ash 1 $nhash_weak_bit)))))
    (incf *loader-buffer-cleanup*)))
