;;; Run inside the initialized cross-loader, before writing its artifacts.
(in-package "CCL")
(let ((writer (backend-xload-info-image-writer-function *wasm32-xload-backend*)))
  (setf (backend-xload-info-image-writer-function *wasm32-xload-backend*)
        (lambda (directory)
          (prog1 (funcall writer directory)
           (labels ((copy-form (form)
                     (cond ((consp form) (xload-make-cons (copy-form (car form))
                                                        (copy-form (cdr form))))
                           ((null form) *xload-target-nil*)
                           ((symbolp form)
                            (or (xload-lookup-symbol form)
                                (if (symbol-package form) (xload-copy-symbol form)
                                  (setf (xload-lookup-symbol form)
                                        (xload-make-symbol (xload-save-string (symbol-name form)))))))
                           (t (xload-integer form))))
                   (evaluate (form) (wasm32-cold-eval (copy-form form))))
            (let* ((a (make-symbol "SAME")) (b (make-symbol "SAME"))
                   (first (evaluate `(setf-function-name ',a)))
                   (second (evaluate `(setf-function-name ',b)))
                   (rows nil))
              (assert (/= first second))
              (assert (= first (evaluate `(setf-function-name ',a))))
              (assert (= second (evaluate `(setf-function-name ',b))))
              (assert (= (evaluate '(setf-function-name 'nil))
                         (evaluate '(setf-function-name 'nil))))
              ;; Independently refuse operator, shape, arity, quote and symbol
              ;; violations, before allocating or publishing any target state.
              (dolist (form '(nil 7 (other 'a) (setf-function-name)
                             (setf-function-name 'a 'b) (setf-function-name . a)
                             (setf-function-name a) (setf-function-name (other a))
                             (setf-function-name (quote))
                             (setf-function-name (quote a b))
                             (setf-function-name (quote . a))
                             (setf-function-name '9) (setf-function-name '(a))))
                (let* ((expr (copy-form form))
                       (size (xload-space-lowptr *xload-dynamic-space*))
                       (data (copy-seq (xload-space-data *xload-dynamic-space*)))
                       (symbols (hash-table-count *xload-symbol-addresses*))
                       (names (copy-list (wasm32-xload-state-setf-names *xload-backend-state*)))
                       (refused (handler-case (progn (wasm32-cold-eval expr) nil)
                                  (simple-error (condition)
                                    (equal (simple-condition-format-control condition)
                                           "Unsupported wasm32 cold-load expression: #x~x")))))
                  (assert refused)
                  (assert (= size (xload-space-lowptr *xload-dynamic-space*)))
                  (assert (equalp data (xload-space-data *xload-dynamic-space*)))
                  (assert (= symbols (hash-table-count *xload-symbol-addresses*)))
                  (assert (equal names (wasm32-xload-state-setf-names *xload-backend-state*)))
                  (push (list :object (cons "form" (format nil "~s" form))
                              (cons "refused" t) (cons "state_preserved" t)) rows)))
              (with-open-file (s (concatenate 'string (getenv "LOADER_OUTPUT") "cold-eval-controls.json")
                                 :direction :output :if-exists :supersede)
                (wasm32-json (list :object (cons "status" "PASS")
                                  (cons "distinct_uninterned_bases" t)
                                  (cons "canonical_repeats" t)
                                  (cons "controls" (reverse rows))) s)
                (terpri s))))
          ))))
