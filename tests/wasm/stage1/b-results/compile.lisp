(in-package "CL-USER")
(defvar *call-refusals*) (defvar *call-sources*) (defvar *call-cases*) (defvar *call-functions*)
(defun call-token (value objects)
  (cond ((null value) "nil") ((eq value t) "t") ((keywordp value) (concatenate 'string ":" (string-downcase (symbol-name value)))) ((integerp value) value)
        ((position value objects :test #'eq) (format nil "n~d" (position value objects :test #'eq)))
        ((consp value) (format nil "n~d" (vector-push-extend value objects)))
        (t (error "Unknown value ~s" value))))
(defun call-json-token (s value) (if (integerp value) (princ value s) (format s "~s" value)))
(defun call-native-case (s row)
  (destructuring-bind (id name nodes args) row
    (let ((objects (make-array (length nodes) :adjustable t :fill-pointer (length nodes))) (values nil) (status "RETURN"))
      (dotimes (i (length nodes)) (setf (aref objects i) (cons nil nil)))
      (labels ((decode (v)
                 (cond ((equal v "nil") nil) ((equal v "t") t)
                       ((and (stringp v) (eql (char v 0) #\:)) (intern (string-upcase (subseq v 1)) "KEYWORD"))
                       ((and (stringp v) (eql (char v 0) #\n)) (aref objects (parse-integer v :start 1)))
                       ((stringp v) (cdr (assoc (subseq v 2) *call-functions* :test #'equal))) (t v))))
        (loop for pair in nodes for i from 0 do (setf (car (aref objects i)) (decode (first pair)) (cdr (aref objects i)) (decode (second pair))))
        (handler-case
            (setq values (multiple-value-list (apply (cdr (assoc name *call-functions* :test #'equal)) (mapcar #'decode args))))
          (type-error (c) (setq status (if (subtypep 'function (type-error-expected-type c)) "DESIGNATOR" "TYPE")))
          (undefined-function () (setq status "DESIGNATOR"))
          (program-error () (setq status "ARITY"))))
      (format s "{\"id\":~s,\"status\":~s,\"values\":[" id status)
      (loop for value in values for i from 0 do (unless (zerop i) (write-char #\, s)) (call-json-token s (call-token value objects)))
      (write-string "],\"nodes\":[" s)
      (loop for i from 0 while (< i (length objects)) do (unless (zerop i) (write-char #\, s)) (write-char #\[ s)
        (call-json-token s (call-token (car (aref objects i)) objects)) (write-char #\, s)
        (call-json-token s (call-token (cdr (aref objects i)) objects)) (write-char #\] s))
      (write-string "]}" s))))
(let ((out (ccl:getenv "CALL_OUTPUT")))
  (load (ccl:getenv "CALL_CASES")) (setq *call-functions* nil)
  (let ((*package* (find-package "WASM32-COMPILER")))
    (dolist (row *call-sources*)
      (let ((fn (compile nil (read-from-string (second row)))))
        (setf (symbol-function (intern (string-upcase (first row)) *package*)) fn)
        (push (cons (first row) fn) *call-functions*))))
  (dolist (row *call-sources*)
    (let ((module (wasm32-compiler::compile-call-module (second row) (first row) (mapcar #'first *call-sources*))))
      (with-open-file (s (concatenate 'string out (first row) ".wat") :direction :output :if-exists :error) (write-string (getf module :wat) s))))
  (let ((module (wasm32-compiler::compile-primitive-module "(lambda (n k s v r) (%slot-index (%validate-slot n k s v r)))" "resolve_slot" '(:u32 :u32 :u32 :u32 :address) :u32)))
    (with-open-file (s (concatenate 'string out "resolve_slot.wat") :direction :output :if-exists :error) (write-string (getf module :wat) s)))
  (with-open-file (s (concatenate 'string out "native.json") :direction :output :if-exists :error)
    (write-char #\[ s) (loop for c in *call-cases* for i from 0 do (unless (zerop i) (write-char #\, s)) (call-native-case s c)) (write-char #\] s))
  (with-open-file (s (concatenate 'string out "refusals.json") :direction :output :if-exists :error)
    (write-char #\[ s)
    (loop for (name source) in *call-refusals* for i from 0 do
      (unless (zerop i) (write-char #\, s))
      (let ((refused nil))
        (handler-case (wasm32-compiler::compile-call-module source name (mapcar #'first *call-sources*))
          (wasm32-compiler::unsupported-wasm32-code () (setq refused t)))
        (assert refused) (format s "{\"name\":~s,\"status\":\"REJECTED\"}" name)))
    (write-char #\] s))
  (format t "S1-B-CALL-COMPILE-PASS~%") (ccl:quit))
