;;; Identical workload forms on native CCL and the accepted Wasm backend.
(in-package "CCL")
(eval-when (:compile-toplevel)
  (proclaim '(optimize (speed 3) (safety 1) (debug 0)))
  (proclaim '(notinline eb-add eb-reference eb-optional eb-rest eb-keyword eb-collect)))
(defvar *eb-sink* nil)

(defun eb-add (x y)
  (declare (fixnum x y))
  (the fixnum (+ x y)))
(defun eb-reference (x) x)
(defun eb-optional (x &optional (y 7 yp)) (values (+ x y) yp))
(defun eb-rest (x &rest rest) (+ x (length rest)))
(defun eb-keyword (x &key (y 7)) (+ x y))

(defun eb-loop (n x)
  (declare (fixnum n x))
  (let ((sum 0))
    (declare (fixnum sum))
    (dotimes (i n sum) (setq sum (the fixnum (+ sum x))))))
(defun eb-call (n x)
  (declare (fixnum n x))
  (let ((sum 0))
    (declare (fixnum sum))
    (dotimes (i n sum) (setq sum (eb-add sum x)))))
(defun eb-reference-call (n pair)
  (declare (fixnum n))
  (let ((value pair))
    (dotimes (i n (car value)) (setq value (eb-reference value)))))
(defun eb-live-reference (n pair)
  (declare (fixnum n))
  (let ((sum 0))
    (declare (fixnum sum))
    (dotimes (i n (+ sum (car pair))) (setq sum (eb-add sum 3)))))
(defun eb-optional-loop (n x)
  (declare (fixnum n))
  (let ((sum 0))
    (dotimes (i n sum) (incf sum (eb-optional x)))))
(defun eb-rest-loop (n x)
  (declare (fixnum n))
  (let ((sum 0))
    (dotimes (i n sum) (incf sum (eb-rest x 1 2 3)))))
(defun eb-keyword-loop (n x)
  (declare (fixnum n))
  (let ((sum 0))
    (dotimes (i n sum) (incf sum (eb-keyword x :y 7)))))

;;; Runtime inputs prevent folding a literal cons, vector or float.
(defun eb-car (n pair)
  (declare (fixnum n))
  (let ((sum 0))
    (dotimes (i n sum) (incf sum (car pair)))))
(defun eb-car-typed (n pair)
  (declare (fixnum n) (cons pair))
  (let ((sum 0))
    (declare (fixnum sum))
    (dotimes (i n sum) (incf sum (the fixnum (car pair))))))
(defun eb-svref (n vector)
  (declare (fixnum n))
  (let ((sum 0))
    (dotimes (i n sum) (incf sum (svref vector (logand i 3))))))
(defun eb-svref-typed (n vector)
  (declare (fixnum n) (type (simple-vector 4) vector))
  (let ((sum 0))
    (declare (fixnum sum))
    (dotimes (i n sum)
      (incf sum (the fixnum (svref vector (the (integer 0 3) (logand i 3))))))))
(defun eb-eq (n pair)
  (declare (fixnum n))
  (let ((sum 0))
    (declare (fixnum sum))
    (dotimes (i n sum)
      (when (eq (car pair) (cdr pair)) (incf sum)))))
(defun eb-fixnum-generic (n x)
  (declare (fixnum n))
  (let ((sum 0)) (dotimes (i n sum) (incf sum x))))
(defun eb-double-generic (n x)
  (declare (fixnum n))
  (let ((sum 0.0d0)) (dotimes (i n sum) (incf sum x))))
(defun eb-double-typed (n x)
  (declare (fixnum n) (double-float x))
  (let ((sum 0.0d0))
    (declare (double-float sum))
    (dotimes (i n sum) (incf sum x))))
(defun eb-single-typed (n x)
  (declare (fixnum n) (single-float x))
  (let ((sum 0.0f0))
    (declare (single-float sum))
    (dotimes (i n sum) (incf sum x))))

;;; Only this collection accessor differs. The target harness collects
;;; synchronously inside the ordinary rooted output callback at this marker.
(defun eb-collect ()
  #+wasm32-target (write-line "EB-GC")
  #-wasm32-target (gc)
  1)
(defun eb-moving-references ()
  (let* ((pair (cons 17 23)) (vector (vector pair pair)) (sum 0))
    (dotimes (i 4)
      (incf sum (eb-collect))
      (assert (eq pair (svref vector 0)))
      (assert (eq (svref vector 0) (svref vector 1)))
      (assert (= (car pair) 17))
      (assert (= (cdr pair) 23)))
    (+ sum (car pair) (cdr pair))))

;;; Each row supplies an independently predictable result, including N=0.
(defun eb-cases ()
  (let ((pair (cons 7 7)))
    (list (list 'eb-loop 3 3 0)
          (list 'eb-call 3 3 0)
          (list 'eb-reference-call pair 0 7)
          (list 'eb-live-reference pair 3 7)
          (list 'eb-optional-loop 3 10 0)
          (list 'eb-rest-loop 7 10 0)
          (list 'eb-keyword-loop 3 10 0)
          (list 'eb-car pair 7 0)
          (list 'eb-car-typed pair 7 0)
          (list 'eb-svref (vector 1 2 3 2) 2 0)
          (list 'eb-svref-typed (vector 1 2 3 2) 2 0)
          (list 'eb-eq pair 1 0)
          (list 'eb-fixnum-generic 3 3 0)
          (list 'eb-double-generic 0.5d0 0.5d0 0.0d0)
          (list 'eb-double-typed 0.5d0 0.5d0 0.0d0)
          (list 'eb-single-typed 0.5f0 0.5f0 0.0f0))))
(defun eb-check (row n value)
  (assert (= value (+ (* n (third row)) (fourth row))))
  (setq *eb-sink* value))
(defun eb-sample (row n)
  (let* ((start (get-internal-real-time))
         (value (funcall (first row) n (second row)))
         (ticks (- (get-internal-real-time) start)))
    (eb-check row n value)
    (values ticks value)))
(defun eb-run ()
  (assert (= (eb-moving-references) 44))
  (write-line "EB-GC-PASS 4 44")
  (let ((cases (eb-cases)) (sizes nil))
    (dolist (row cases)
      (dolist (n '(0 4 16 100))
        (eb-check row n (funcall (first row) n (second row)))))
    ;; Calibrate to >=50ms, then warm each workload for >=250ms.
    ;; N is a multiple of four; sums stay inside the wasm32 fixnum range,
    ;; and the .5 increments remain exact at both float widths.
    (dolist (row cases)
      (let ((n 256))
        (loop
          (when (or (>= (eb-sample row n) (/ internal-time-units-per-second 20))
                    (= n 4194304))
            (return))
          (setq n (* n 2)))
        (let ((start (get-internal-real-time)))
          (loop do (eb-sample row n)
                until (>= (- (get-internal-real-time) start)
                          (/ internal-time-units-per-second 4))))
        (push (cons row n) sizes)))
    (setq sizes (nreverse sizes))
    ;; Rotate the order every round; no timing overlaps compilation or tracing.
    (dotimes (trial 9)
      (dolist (entry sizes)
        (let ((row (car entry)) (n (cdr entry)))
          (format t "EB-BEGIN ~a ~d ~d~%" (first row) trial n)
          (multiple-value-bind (ticks value) (eb-sample row n)
            (format t "EB-END ~a ~d ~d ~d ~d ~d~%"
                    (first row) trial n ticks internal-time-units-per-second
                    (round value)))))
      (setq sizes (append (cdr sizes) (list (car sizes)))))
  (write-line "EB-PASS 16 9")))

(eb-run)
