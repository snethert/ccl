(in-package :wasm32-compiler)

(defun lap-inputs (s)
  (cond ((equal s "%ILOGCOUNT") '((0) (1) (7) (255) (536870911) (#x15555555) (#x0f0f0f0f)))
        ((equal s "%FIXNUM-INTLEN") '((0) (1) (2) (255) (256) (-1) (-2) (-256) (536870911) (-536870912)))
        ((equal s "%IASH") '((1 0) (1 5) (-1 5) (1000 -3) (-1000 -3) (536870911 -28) (5 20) (-5 20) (3 -40) (-3 -40) (0 7)))
        ((equal s "%FIXNUM-TRUNCATE") '((7 2) (-7 2) (7 -2) (-7 -2) (536870911 7) (-536870912 7) (0 5) (5 5) (-536870912 -1) (5 -1) (-536870912 1) (1 536870911)))
        ((equal s "FAST-MOD") '((0 7) (6 7) (7 7) (100 7) (536870911 12345) (12 1)))
        ((equal s "%INIT-GVECTOR") '((3 :x #(1 2 3 4)) (0 :x #(1)) (2 nil #(1 2))))
        ((equal s "%COPY-GVECTOR-TO-GVECTOR") '((#(1 2 3 4 5) 1 #(a b c d e) 0 3) (#(1 2 3) 0 #(x y z) 0 0) (#(1 2 3) 0 #(x y z w) 1 3)))
        ((equal s "CORE-LAP-GVECTOR-OVERLAP") '((5 t) (5 nil) (8 t) (8 nil) (0 t)))
        ((equal s "CORE-LAP-ALLOCATE-LIST") '((:a 0) (:a 3) (nil 1)))
        ((equal s "%SYMPTR->SYMBOL") '((t) (:x) (car)))
        ((equal s "TRUE") '(() (1) (1 2 3)))
        ((equal s "CORE-LAP-STRING-HASH") '(("") ("a") ("hello") ("PNAME-HASH") ("λ😁x") ("abcdefghijklmnopqrstuvwxyz")))
        ((equal s "CORE-LAP-SUBSTRING-HASH") '(("hello world" 0 5) ("hello world" 6 5) ("hello world" 3 0)))
        ((equal s "CORE-LAP-STORE-CONDITIONAL") '((#(a b c) 1 b :new) (#(a b c) 1 :other :new) (#(a b c) 0 a nil)))
        ((equal s "CORE-LAP-ATOMIC-INCF") '((#(0 10 20) 1 5) (#(0 10 20) 2 -25) (#(0 10 20) 0 0)))
        ((equal s "CORE-LAP-HEADER-OFFSET") '((0) (3) (6)))
        ((equal s "SINGLE-FLOAT-BITS") '((1.5f0) (-0.0f0) (0.0f0) (1.0f-40) (-3.0f38)))
        ((equal s "DOUBLE-FLOAT-BITS") '((1.5d0) (-0.0d0) (0.0d0) (1d300) (5d-324) (-2.5d-100)))
        ((equal s "DOUBLE-FLOAT-FROM-BITS") '((#x3ff80000 0) (#x80000000 0) (0 1) (#x7fefffff #xffffffff) (#xc0000000 #xdeadbeef)))
        ((member s '("%DOUBLE-FLOAT-SIGN" "%DOUBLE-FLOAT-EXP" "%INTEGER-DECODE-DOUBLE-FLOAT") :test #'equal)
         '((1.5d0) (-1.5d0) (-0.0d0) (0.0d0) (1.0d0) (0.5d0) (5d-324) (1d308) (-123456789.125d0)))
        ((member s '("%SHORT-FLOAT-SIGN" "%SHORT-FLOAT-EXP") :test #'equal) '((1.5f0) (-1.5f0) (-0.0f0) (0.0f0) (1.0f-40) (3.0f38)))
        ((equal s "SET-%DOUBLE-FLOAT-EXP") '((1.5d0 1024) (-1.5d0 1022) (2.5d0 0) (0.75d0 2046)))
        ((equal s "%%DOUBLE-FLOAT-ABS!") '((-1.5d0 99.0d0) (2.5d0 98.0d0) (-0.0d0 97.0d0) (-1d300 96.0d0)))
        ((equal s "%DOUBLE-FLOAT-NEGATE!") '((-1.5d0 95.0d0) (2.5d0 94.0d0) (0.0d0 93.0d0) (1d-300 92.0d0)))
        ((equal s "%MAKE-FLOAT-FROM-FIXNUMS") '((91.0d0 #x1000000 0 1023 1) (90.0d0 #x1800000 0 1023 -1) (89.0d0 #x1000000 #x8000000 1024 1) (88.0d0 #x1ffffff #xfffffff 2046 1) (87.0d0 1 0 0 1)))
        ((equal s "CORE-LAP-MAKE-SHORT") '((0 127 1) (#x400000 127 -1) (#x7fffff 254 1) (1 0 1)))
        ((equal s "%%SCALE-DFLOAT!") '((1.5d0 1024 86.0d0) (1.5d0 1022 85.0d0) (-3.0d0 1033 84.0d0) (1.0d0 1023 83.0d0)))
        ((member s '("%TRUNCATE-DOUBLE-FLOAT->FIXNUM" "%ROUND-NEAREST-DOUBLE-FLOAT->FIXNUM") :test #'equal)
         '((0.0d0) (-0.0d0) (1.5d0) (-1.5d0) (2.5d0) (-2.5d0) (0.49999d0) (0.5d0) (536870911.0d0) (-536870912.0d0) (536870911.4d0) (-536870911.6d0) (123456.789d0)))
        ((member s '("%TRUNCATE-SHORT-FLOAT->FIXNUM" "%ROUND-NEAREST-SHORT-FLOAT->FIXNUM") :test #'equal)
         '((0.0f0) (-0.0f0) (1.5f0) (-1.5f0) (2.5f0) (-2.5f0) (0.5f0) (1234.567f0) (-99999.9f0) (8388608.0f0)))
        ((equal s "%DOUBLE-FLOAT-SQRT!") '((4.0d0 78.0d0) (2.0d0 77.0d0) (0.0d0 76.0d0) (-0.0d0 75.0d0) (1d300 74.0d0) (1.0d-300 73.0d0)))
        ((equal s "CORE-LAP-SQRT-SINGLE") '((4.0f0) (2.0f0) (0.0f0) (-0.0f0) (1.0f30)))
        ((equal s "CORE-LAP-SQRT-INVALID") '((-4.0d0) (-1.0f0)))
        ((equal s "%SET-HASH-TABLE-VECTOR-KEY") '((#(a b c) 1 :k) (#(a b c) 0 nil)))
        ((equal s "CORE-LAP-HASH-KEY-CONDITIONAL") '((#(a b c) 1 b :new) (#(a b c) 1 :other :new)))
        ((equal s "CORE-LAP-STRIP-TAG") '((7) (-7) (0) (:x) ("s") ((1 . 2)) (1.5d0)))
        ((equal s "CORE-LAP-SYMPTR-ROUND-TRIP") '((nil) (t) (:x) (car)))
        ((equal s "CORE-LAP-CALLED-FOR-MV") '((7) (:x)))
        ((member s '("FIX-BIG-LOGAND" "FIX-BIG-LOGANDC1" "FIX-BIG-LOGANDC2" "LOGTEST-FIX-BIG") :test #'equal)
         (loop for fix in '(0 1 -1 #x5555 #x-5555 536870911 -536870912) append
           (loop for big in (list (ash 1 70) (1- (ash 1 96)) (- (ash 1 70)) (- (1+ (ash 1 96))) #x123456789abcdef0123 (- #xfedcba9876543210fed))
                 collect (list fix big))))
        ((equal s "BIGNUM-LOGTEST") (loop for a in (list (ash 1 70) (1- (ash 1 96)) (- (ash 1 70)) #x123456789abcdef0123 (ash 1 100)) append
                                       (loop for b in (list (ash 3 69) (ash 1 100) (- (ash 1 64)) #x30000000000000000000) collect (list a b))))
        ((equal s "%SHORT-FLOAT->DOUBLE-FLOAT") '((1.5f0 82.0d0) (-0.0f0 81.0d0) (1.0f-40 80.0d0) (-3.0f38 79.0d0)))
        (t nil)))

