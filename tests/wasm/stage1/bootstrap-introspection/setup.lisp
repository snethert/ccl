(in-package :wasm32-compiler)
(load (merge-pathnames "measure.lisp" *load-pathname*))
(load (merge-pathnames "../bootstrap-recipes/measure.lisp" *load-pathname*))
(call-with-target (lambda () (load "ccl:xdump;hashenv.lisp")))
(let ((output (ccl:getenv "RECOUNT_OUTPUT")))
  (with-open-file (s (concatenate 'string output "worklist.json")
                     :direction :output :if-exists :error)
    (write-char #\[ s)
    (loop for path in (library-worklist) for i from 0 do
      (unless (zerop i) (write-char #\, s))
      (let* ((text (namestring (translate-logical-pathname path)))
             (start (or (search "level-0/" text) (search "level-1/" text))))
        (assert start)
        (file-json-string (subseq text start) s)))
    (write-char #\] s))
  (ccl:save-application (concatenate 'string output "compiler.image")))
