(in-package :wasm32-compiler)

;;; Admission precedes publishing any image root. These are the native class
;;; and method fields, not a parallel catalogue maintained by the owner.
(defun ready-image-status (image)
  (dolist (entry (svref image 11))
    (let ((class (cdr entry)))
      (unless (ccl::%standard-instance-p class)
        (return-from ready-image-status :class-shape))
      (unless (and (consp (ccl::%class.cpl class))
                   (eq (car (ccl::%class.cpl class)) class))
        (return-from ready-image-status :class-cpl))
      (let ((wrapper (ccl::%class.own-wrapper class)))
        (unless (and wrapper (eq (ccl::%wrapper-class wrapper) class))
          (return-from ready-image-status :class-wrapper))
        (when (eql (ccl::%wrapper-hash-index wrapper) 0)
          (return-from ready-image-status :obsolete-wrapper)))))
  (dolist (gf (cons (symbol-function 'ccl::eql-specializer-object)
                   (append (svref image 8)
                           (loop for entry in (first (svref image 12)) collect (car entry)))))
    (unless (eq (ccl::%gf-method-combination gf)
                ccl::*standard-method-combination*)
      (return-from ready-image-status :method-combination))
    (dolist (method (ccl::%gf-methods gf))
      (unless (functionp (ccl::%method-function method))
        (return-from ready-image-status :method-function))))
  t)

;;; Directed admission checks restore the source image after every mutation.
;;; This entry is a qualification caller, not part of the startup worklist.
(defun ready-image-refusals (image)
  (let* ((entry (car (svref image 11)))
         (class (cdr entry))
         (wrapper (ccl::%class.own-wrapper class))
         (gf (car (svref image 8)))
         (method (car (ccl::%gf-methods gf))))
    (macrolet ((check (place value)
                 `(let ((old ,place))
                    (unwind-protect
                        (progn (setf ,place ,value) (ready-image-status image))
                      (setf ,place old)))))
      (list (check (cdr entry) nil)
            (check (ccl::%class.cpl class) nil)
            (check (ccl::%class.cpl class) (list nil))
            (check (ccl::%class.own-wrapper class) nil)
            (check (ccl::%wrapper-class wrapper) nil)
            (check (ccl::%wrapper-hash-index wrapper) 0)
            (check (ccl::sgf.method-combination gf) nil)
            (check (ccl::%method.function method) nil)
            (ready-image-status image)))))

;;; Exercise the public function cells, not the compiler's direct-call
;;; substitution. Those cells must use the admitted table implementation too.
(defun ready-table-bindings (image)
  (core-condition-prepare image)
  (let ((table (ccl::%wasm-make-class-table 4))
        (keys nil)
        (sum 0))
    (dotimes (i 20)
      (let ((key (cons i nil)))
        (push key keys)
        (funcall (symbol-function 'ccl::puthash) key table i))
      (when (zerop (logand i 3)) (core-collect)))
    (dolist (key keys)
      (multiple-value-bind (value found) (funcall (symbol-function 'gethash) key table)
        (unless found (error "A READY table binding lost a key."))
        (incf sum value)))
    (let ((removed (funcall (symbol-function 'remhash) (car keys) table)))
      (core-collect)
      (multiple-value-bind (value found)
          (funcall (symbol-function 'gethash) (car keys) table :absent)
        (funcall (symbol-function 'clrhash) table)
        (core-collect)
        (multiple-value-bind (empty present)
            (funcall (symbol-function 'gethash) (cadr keys) table :empty)
          (values sum removed value found empty present))))))

;;; The selected image already contains initialized classes and method bodies.
;;; Reset host-lifetime state, publish its roots, and select uncached dispatch.
(defun ready-initialize (image)
  (unless (eq (ready-image-status image) t)
    (error "The READY image is not finalized."))
  (core-condition-prepare image)
  (let ((gfs (cons (symbol-function 'ccl::eql-specializer-object) (svref image 8))))
    (dolist (entry (first (svref image 12)))
      (pushnew (car entry) gfs :test #'eq))
    (setq ccl::%all-gfs% (ccl::%cons-population gfs)
          ccl::*enable-automatic-termination* nil
          ccl::*%periodic-tasks%* nil))
  (values (length (ccl::population.data ccl::%all-gfs%))
          ccl::*enable-automatic-termination*
          ccl::*%periodic-tasks%*))

(defun ready-check (image)
  (let ((count 0))
    (dolist (entry (svref image 11))
      (unless (eq (find-class (car entry)) (cdr entry))
        (error "The class image lost a class cell."))
      (incf count))
    (let ((gfs (ccl::population.data ccl::%all-gfs%)))
      (dolist (gf (cons (symbol-function 'ccl::eql-specializer-object) (svref image 8)))
        (unless (ccl::memq gf gfs) (error "A projected generic function was lost.")))
      (dolist (entry (first (svref image 12)))
        (unless (ccl::memq (car entry) gfs) (error "An invalidation generic function was lost."))))
    (unless (and (not ccl::*enable-automatic-termination*)
                 (not ccl::*%periodic-tasks%*))
      (error "The image startup roots are not initialized."))
    (multiple-value-bind (sum removed value found empty present)
        (ready-table-bindings image)
      (unless (and (= sum 190) removed (eq value :absent) (not found)
                   (eq empty :empty) (not present))
        (error "The READY public table bindings failed.")))
    (core-collect)
    (let ((condition (make-condition 'cpl-derived)))
      (values count
              (length (ccl::population.data ccl::%all-gfs%))
              (slot-value condition 'payload)
              (slot-value condition 'other)
              (handler-case (error "READY condition dispatch")
                (simple-error () :caught))))))

(defun ready-start (image)
  (ready-initialize image)
  (core-collect)
  (ready-check image))
