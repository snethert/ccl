;;; Private source SETF lookup and computed-call witness. No global definition changes.
(defpackage :ccl-target-setf (:use :cl))
(in-package :ccl-target-setf)
(defvar *trace* nil)
(defvar *phase* "dumplisp")
(defvar *event* :null)
(defvar *mode* "normal")
(defvar *cache* nil)
(defvar *environment* nil)
(defvar *escape* nil)
(defvar *effects* nil)
(defun obj (&rest xs) (apply #'ccl-target-helpers::obj xs))
(defun syntax (x) (ccl-source-expanders::syntax x))
(defun ident (x) (if x (ccl-source-expanders::ident x) :null))
(defun field (x key) (ccl-source-traversal::field x key))
(defun label (x) (ccl-source-expanders::label x))
(defun invoke (fn form env)
  (let ((ok nil) (answer nil))
    (unwind-protect
      (progn
        (setf answer (multiple-value-list (funcall fn form (if (equal *mode* "drop-environment") nil env))) ok t)
        (cond ((equal *mode* "drop-values") (first answer))
              ((equal *mode* "drop-getter") (values-list (subseq answer 0 4)))
              (t (values-list answer))))
      (push (obj "kind" "call" "phase" *phase* "event" *event* "function_id" (ident fn)
                 "input" (syntax form) "environment_id" (ident env)
                 "status" (if ok "RETURNED" "ESCAPED")
                 "values" (if ok (mapcar #'syntax answer) :null)) *trace*))))
(defun observe-lookup (name values)
  (let ((value (first values)))
    (push (obj "kind" "lookup" "phase" *phase* "event" *event* "operator" (label name)
               "table_id" (ident ccl::%setf-methods%) "present" (if (second values) :true :false)
               "value_kind" (cond ((null value) "null") ((symbolp value) "symbol") ((functionp value) "function") (t "invalid"))
               "value" (if (functionp value) (ident value) (syntax value))) *trace*)
    (when (and (equal *mode* "cached-method") (functionp value))
      (setf (first values) (or *cache* (setf *cache* value))))
  (values-list values)))
(defun info (name env)
  (if (equal *mode* "ignore-local") (values :function nil) (ccl:function-information name env)))
(defun build ()
  (let* ((form (ccl-target-helpers::read-form "lib/macros.lisp" "defmacro setf"))
         (lookup (ccl-target-helpers::read-form "lib/setf.lisp" "defun %setf-method"))
         (invoke-count 0) (info-count 0))
    (labels ((rewrite (x)
      (cond ((equal x '(funcall ccl::temp ccl::form ccl::env)) (incf invoke-count) '(invoke ccl::temp ccl::form ccl::env))
            ((and (consp x) (eq (car x) 'ccl:function-information)) (incf info-count) (cons 'info (cdr x)))
            ((consp x) (cons (rewrite (car x)) (rewrite (cdr x)))) (t x))))
      (let ((body (rewrite (cdddr form))))
        (unless (and (= invoke-count 1) (= info-count 1)) (error "SETF-SOURCE-SITES"))
        (ccl-census-macros::native-function
         `(lambda (form env)
            (let ((*event* (if (equal *phase* "dumplisp") (1- ccl-source-expanders::*next-event*) :null)))
              (flet ((ccl::%setf-method ,(third lookup)
                       (observe-lookup ccl::name (multiple-value-list (progn ,@(cdddr lookup))))))
                (funcall (function ,(ccl::parse-macro-1 (second form) (third form) body)) form env)))))))))
(defun method-a (form env)
  (unless (eq env *environment*) (error "SETF-ENVIRONMENT-LOST"))
  (values '(temporary) (cdr form) '(first-value second-value)
          '(store-pair temporary first-value second-value) '(read-pair temporary)))
(defun method-b (form env)
  (unless (eq env *environment*) (error "SETF-ENVIRONMENT-LOST"))
  (values '(temporary) (cdr form) '(first-value second-value)
          '(store-pair temporary second-value first-value) '(read-pair temporary)))
(defun escaping (form env) (declare (ignore form env)) (throw *escape* :escaped))
(defun effect (value) (push (if (consp value) :place value) *effects*) value)
(defun store-pair (cell a b) (push :store *effects*) (setf (car cell) a (cdr cell) b) (values a b))
(defun record-probe (name fn form env &optional execute)
  (let ((*phase* name) (answer nil) (failure nil) (observed nil) (cell (cons 0 0)) (*effects* nil))
    (handler-case
      (progn
        (setf answer (funcall fn form env))
        (when execute
          (setf observed (multiple-value-list
            (funcall (ccl-census-macros::native-function `(lambda (cell) ,answer)) cell)))))
      (error (e) (setf failure (princ-to-string e))))
    (obj "name" name "input" (syntax form) "status" (if failure "ERROR" "RETURNED")
         "output" (if failure :null (syntax answer)) "problem" (or failure :null)
         "values" (syntax observed) "cell" (syntax cell) "effects" (syntax (reverse *effects*)))))
(defun probes-under-target (fn bridge)
  (let ((rows nil) (*cache* nil) (*escape* (gensym))
        (*environment* (ccl:augment-environment nil :variable '(sentinel)))
        (table (make-hash-table :test #'eq)) (original ccl::%setf-methods%))
    (maphash (lambda (k v) (setf (gethash k table) v)) original)
    (let ((ccl::%setf-methods% table) (*gensym-counter* 10000)
          (form '(setf (probe-place (effect cell)) (values (effect 11) (effect 22)))))
      (setf (gethash 'probe-place table) #'method-a)
      (push (record-probe "callable" fn form *environment* t) rows)
      (setf (gethash 'probe-place table) #'method-b)
      (push (record-probe "replacement" fn form *environment* t) rows)
      (setf (gethash 'probe-place table) 'symbol-setter)
      (push (record-probe "symbol" fn '(setf (probe-place cell) 7) *environment*) rows)
      (remhash 'probe-place table)
      (push (record-probe "absent" fn '(setf (probe-place cell) 7) *environment*) rows)
      (setf (gethash 'probe-place table) nil)
      (push (record-probe "present-nil" fn '(setf (probe-place cell) 7) *environment*) rows)
      (setf (gethash 'probe-place table) #'method-a)
      (push (record-probe "local-function" fn '(setf (probe-place cell) 7)
             (ccl:augment-environment nil :function '(probe-place))) rows)
      (let ((*phase* "nonlocal") (answer nil) (returned nil))
        (setf (gethash 'probe-place table) #'escaping)
        (unwind-protect
          (setf answer (catch *escape* (funcall fn form *environment*) (setf returned t)))
          (setf (gethash 'probe-place table) #'method-a))
        (push (obj "name" "nonlocal" "escaped" (if (and (eq answer :escaped) (not returned)) :true :false)
                   "restored" (if (eq (gethash 'probe-place table) #'method-a) :true :false)) rows))
      (push (record-probe "after-nonlocal" fn form *environment* t) rows)
      (let ((*phase* "bridge-values") (answer nil) (problem nil))
        (handler-case (setf answer (multiple-value-list (funcall bridge #'method-a (second form) *environment*)))
          (error (e) (setf problem (princ-to-string e))))
        (push (obj "name" "bridge-values" "status" (if problem "ERROR" "RETURNED")
                   "problem" (or problem :null) "values" (if problem :null (mapcar #'syntax answer))) rows))
      (values (reverse rows)
              (obj "table_id" (ident table) "environment_id" (ident *environment*) "original_table_id" (ident original)
                   "context" (ccl-source-traversal::context)
                   "method_a_id" (ident #'method-a) "method_b_id" (ident #'method-b) "escaping_id" (ident #'escaping))))))
(defun probes (fn &optional (bridge #'invoke))
  (ccl-census-descriptions::with-descriptions
    (lambda () (ccl-census-stub::with-target-state
      (lambda () (probes-under-target fn bridge))))))
(defun file-registry ()
  (obj "table_id" (ident ccl::%setf-methods%) "entries"
    (mapcar (lambda (name)
      (multiple-value-bind (fn present) (gethash name ccl::%setf-methods%)
        (obj "operator" (label name) "present" (if present :true :false)
             "value_kind" (cond ((null fn) "null") ((symbolp fn) "symbol") ((functionp fn) "function") (t "invalid"))
             "value" (if (functionp fn) (ident fn) (syntax fn))
             "source_note" (if (functionp fn) (ccl-source-expanders::note fn) :null))))
      '(ccl::*%saved-method-var%* ccl::basic-stream.state ccl::%svref slot-value ccl::interrupt-level))))
(defun inverse-sources ()
  (mapcar (lambda (spec)
            (destructuring-bind (path marker) spec
              (syntax (ccl-target-helpers::read-form path marker))))
          '(("level-1/l1-utils.lisp" "defsetf *%saved-method-var%*")
            ("lib/macros.lisp" "defsetf %svref")
            ("level-1/l1-clos-boot.lisp" "defsetf slot-value")
            ("lib/macros.lisp" "defsetf interrupt-level"))))
(defun run ()
  (let ((*trace* nil) (*phase* "dumplisp") (*mode* "normal") (ccl-census-macros::*sources* nil) (ccl-census-macros::*registry* nil)
        (ccl-source-expanders::*registry* nil) (ccl-source-expanders::*compiled* nil)
        (ccl-source-expanders::*events* nil) (ccl-source-expanders::*next-event* 0)
        (ccl-source-expanders::*literals* nil) (ccl-target-helpers::*sources* nil)
        (ccl-target-helpers::*calls* nil) (ccl-target-types::*trace* nil) (ccl-target-predicates::*trace* nil)
        (ccl-target-aliases::*trace* nil) (ccl-target-aliases::*aliases* nil)
        (ccl-target-predicates::*mode* "normal") (ccl-target-aliases::*mode* "normal")
        (before (ccl-source-traversal::state)) (old-hook *macroexpand-hook*) (old-setf (macro-function 'setf))
        (old-table ccl::%setf-methods%)
        (old-methods (let ((rows nil)) (maphash (lambda (k v) (push (cons k v) rows)) ccl::%setf-methods%) rows))
        (old-p2 (ccl::backend-p2-compile ccl::*host-backend*))
        (names '(ccl::%setf-method ccl::backend-arch-macroexpand arch::arch-macro-function arch::target-arch-macros arch::find-target-arch typep ccl::specifier-type-if-known ccl::optimize-typep ccl::optimize-ctypep ccl::nx-target-type)))
   (let ((globals (mapcar #'fdefinition names)))
    (ccl-source-expanders::prepare)
    (dolist (r (reverse ccl-source-expanders::*registry*)) (ccl-target-helpers::ident (third r)) (ccl-target-helpers::ident (fourth r)))
    (flet ((source (path name) (ccl-target-helpers::read-form path name)))
     (let* ((helper (source "compiler/optimizers.lisp" "defun eql-iff-eq-p"))
            (range (source "compiler/nx0.lisp" "defun nx1-target-fixnump"))
            (eql-form (source "compiler/optimizers.lisp" "define-compiler-macro eql"))
            (typep-form (source "compiler/nx0.lisp" "defun nx-form-typep"))
            (form-type (source "compiler/nx0.lisp" "defun nx-form-type"))
            (target-type (source "compiler/nx-basic.lisp" "defun nx-target-type"))
            (lookup (source "compiler/nx0.lisp" "defun nx-lookup-target-uvector-subtag"))
            (stream (source "compiler/optimizers.lisp" "define-compiler-macro basic-stream-p"))
            (vector (source "compiler/optimizers.lisp" "define-compiler-macro vectorp"))
            (macro (source "compiler/optimizers.lisp" "define-compiler-macro typep"))
            (optimizer (source "compiler/optimizers.lisp" "defun optimize-typep"))
            (entry (ccl-target-helpers::compiler-entry 'typep)) (compiled nil) (dispatcher nil) (setf-fn nil) (file-registry nil)
            (inverses (inverse-sources)))
       (ccl-source-expanders::with-compiler-observation
        (lambda ()
         (setf (third (ccl-target-helpers::compiler-entry 'eql))
               (ccl-target-types::build helper range eql-form typep-form form-type target-type "normal")
               (third (ccl-target-helpers::compiler-entry 'ccl::basic-stream-p)) (ccl-target-helpers::build-stream lookup stream)
               (third (ccl-target-helpers::compiler-entry 'vectorp)) (ccl-target-helpers::build-stream lookup vector)
               compiled (ccl-target-aliases::build macro optimizer target-type)
               (third entry) compiled
               dispatcher (ccl-target-dispatch::build)
               setf-fn (build))))
       (setf (third (find-if (lambda (r) (and (eq (first r) 'setf) (equal (second r) "macro"))) ccl-source-expanders::*registry*)) setf-fn)
       (dolist (r ccl-source-expanders::*registry*)
         (when (equal (second r) "architecture-dispatch") (setf (third r) dispatcher)))
       (setf file-registry (file-registry))
       (let ((ccl-target-predicates::*phase* "dumplisp")) (ccl-source-expanders::with-routing #'ccl-census-descriptions::run))
       (let* ((file-trace (reverse *trace*))
              (file-events (sort (copy-list ccl-source-expanders::*events*) #'< :key (lambda (e) (field e "sequence"))))
              (*trace* nil) (*mode* (or (ccl:getenv "CCL_SETF_MODE") "normal")))
         (multiple-value-bind (rows metadata) (probes setf-fn)
          (multiple-value-bind (reference-rows reference-metadata)
              (let ((*mode* "normal") (*trace* nil))
                (probes (macro-function 'setf) (lambda (fn form env) (funcall fn form env))))
           (unless (and (equal before (ccl-source-traversal::state)) (eq old-hook *macroexpand-hook*) (eq old-setf (macro-function 'setf))
                        (eq old-p2 (ccl::backend-p2-compile ccl::*host-backend*))
                        (every #'eq globals (mapcar #'fdefinition names))
                        (eq old-table ccl::%setf-methods%)
                        (= (hash-table-count old-table) (length old-methods))
                        (every (lambda (r) (multiple-value-bind (value present) (gethash (car r) old-table)
                                             (and present (eq value (cdr r))))) old-methods)) (error "SETF-STATE-NOT-RESTORED"))
           (with-open-file (out (ccl:getenv "CCL_SETF_OUTPUT") :direction :output :if-exists :error :external-format :utf-8)
             (ccl-startup-census::json
              (obj "version" 1 "sources" (reverse ccl-target-helpers::*sources*) "selected_id" (ident setf-fn)
                   "compiled" (cdr (assoc setf-fn ccl-source-expanders::*compiled* :test #'eq))
                   "events" file-events "inverse_sources" inverses "file_registry" file-registry "file_trace" file-trace "probe_registry" metadata
                   "reference_probes" reference-rows "reference_registry" reference-metadata
                   "probes" rows "probe_trace" (reverse *trace*) "restored" :true
                   "macro_environment_qualified" :false "graph_edges_replaced" 0) out) (terpri out))))))))))
