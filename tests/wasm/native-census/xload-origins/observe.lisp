;;; Observe the existing xloader in a disposable process, without source edits.
(ccl::in-development-mode
 (ccl::require-modules (ccl::target-xload-modules))
 (load "ccl:xdump;faslenv.lisp"))
(defpackage :ccl-xload-origins (:use :cl))
(in-package :ccl-xload-origins)

(defun jstring (s out)
  (write-char #\" out)
  (loop for c across s do
    (case c (#\" (write-string "\\\"" out)) (#\\ (write-string "\\\\" out))
      (t (if (< (char-code c) 32) (format out "\\u~4,'0x" (char-code c)) (write-char c out)))))
  (write-char #\" out))
(defun json (v out)
  (cond ((eq v :null) (write-string "null" out))
        ((stringp v) (jstring v out)) ((integerp v) (princ v out))
        ((and (consp v) (eq (car v) :object))
         (write-char #\{ out)
         (loop for (key value) on (cdr v) by #'cddr for first = t then nil do
           (unless first (write-char #\, out)) (jstring key out) (write-char #\: out) (json value out))
         (write-char #\} out))
        ((listp v) (write-char #\[ out)
         (loop for value in v for first = t then nil do
           (unless first (write-char #\, out)) (json value out)) (write-char #\] out))
        (t (error "Unsupported witness value ~s" v))))
(defun obj (&rest fields) (cons :object fields))

(defun target-fixnum (word)
  (assert (zerop (logand word (1- (ash 1 ccl::*xload-target-fixnumshift*)))))
  (ash word (- ccl::*xload-target-fixnumshift*)))

(defun location (address)
  (if (or (null address) (= address ccl::*xload-target-nil*)) :null
      (let* ((header (ccl::xload-natural-at-address (+ address ccl::*xload-target-misc-header-offset*)))
             (len (ash header -8)))
        (assert (and (= len 4) (= (logand header 255) (ccl::xload-target-subtype :struct))
                     (eq (ccl::xload-lookup-symbol-address
                          (ccl::xload-%svref (ccl::xload-car (ccl::xload-%svref address 0)) 1))
                         'ccl::source-note)))
        (let* ((range (ccl::xload-%svref address 3))
               (filename (ccl::xload-%svref address 2))
               (pair (ccl::xload-target-consp range))
               (packed (unless pair (target-fixnum range)))
               (start (if pair (target-fixnum (ccl::xload-car range)) (ash packed -14))))
        (assert (= (ccl::xload-u8-at-address (+ filename ccl::*xload-target-misc-subtag-offset*))
                   (ccl::xload-target-subtype :simple-string)))
        (obj "address" address "header" header
             "words" (loop for i below len collect (ccl::xload-%svref address i))
             "filename" (ccl::xload-get-string filename)
             "range_encoding" (if pair "pair" "packed")
             "range_words" (if pair (list (ccl::xload-car range) (ccl::xload-cdr range)) (list range))
             "start" start "end" (if pair (target-fixnum (ccl::xload-cdr range))
                                      (+ start (logand packed #x3fff))))))))

(defun run ()
  (ccl::require-modules (ccl::target-xload-modules))
  (let* ((table ccl::*xload-fasl-dispatch-table*)
         (reader (svref table ccl::$fasl-lfuncall))
         (loader (symbol-function 'ccl::xload-fasload))
         (dumper (symbol-function 'ccl::xload-dump-image))
         (rows nil) (paths nil) (final nil) (image-queue nil) (dump-count 0) (target-nil nil)
         (owner (ccl::%current-tcr)) (count 0)
         (mode (ccl:getenv "CCL_XLOAD_CONTROL")))
    (unwind-protect
      (progn
        (setf (symbol-function 'ccl::xload-fasload)
              (lambda (names)
                (assert (null paths))
                (setq paths (mapcar #'namestring names))
                (funcall loader names)))
        (setf (svref table ccl::$fasl-lfuncall)
              (lambda (s)
                (assert (eql owner (ccl::%current-tcr)))
                (let ((before ccl::*xload-cold-load-functions*)
                      (offset (1- (ccl::%fasl-get-file-pos s)))
                      (file (ccl::faslstate.faslfname s)))
                  (multiple-value-prog1 (funcall reader s)
                    (assert (eq before (cdr ccl::*xload-cold-load-functions*)))
                    (incf count)
                    (unless (and (equal mode "omit-entry") (= count 1))
                    (push (obj "position" count "file" file "opcode_offset" offset
                               "target_function" (car ccl::*xload-cold-load-functions*)
                               "source_file" (if ccl::*xload-loading-file-source-file*
                                 (ccl::xload-get-string ccl::*xload-loading-file-source-file*) :null)
                               "location_word" (or ccl::*xload-loading-toplevel-location* :null)
                               "location" (location ccl::*xload-loading-toplevel-location*)) rows))))))
        (setf (symbol-function 'ccl::xload-dump-image)
              (lambda (&rest args)
                (incf dump-count)
                (setq target-nil ccl::*xload-target-nil*)
                (setq final (copy-list ccl::*xload-cold-load-functions*))
                (let ((address (ccl::xload-symbol-value (ccl::xload-lookup-symbol 'ccl::*xload-cold-load-functions*))))
                  (loop until (= address ccl::*xload-target-nil*) do
                    (assert (< (length image-queue) (1+ count)))
                    (push (ccl::xload-car address) image-queue)
                    (setq address (ccl::xload-cdr address)))
                  (setq image-queue (nreverse image-queue)))
                (assert (equal final image-queue))
                (when (equal mode "abort-before-dump") (error "XLOAD-CONTROL-ABORT"))
                (apply dumper args)))
        (ccl::xload-level-0 nil)
        (assert (= dump-count 1))
        (with-open-file (out (ccl:getenv "CCL_XLOAD_OUTPUT") :direction :output :if-exists :error :external-format :utf-8)
          (json (obj "version" 1 "target_nil" target-nil "paths" paths "entries" (nreverse rows) "host_queue" final "image_queue" image-queue) out)
          (terpri out))
        (format t "XLOAD-ORIGINS-COMPLETE ~d~%" count))
      (setf (svref table ccl::$fasl-lfuncall) reader
            (symbol-function 'ccl::xload-fasload) loader
            (symbol-function 'ccl::xload-dump-image) dumper)
      (assert (and (eq (svref table ccl::$fasl-lfuncall) reader)
                   (eq (symbol-function 'ccl::xload-fasload) loader)
                   (eq (symbol-function 'ccl::xload-dump-image) dumper)))
      (format t "XLOAD-WRAPPERS-RESTORED~%"))))
