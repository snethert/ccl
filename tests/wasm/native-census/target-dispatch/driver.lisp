;;; Private U1 architecture lookup chain; no global function redefinition.
(defpackage :ccl-target-dispatch (:use :cl))
(in-package :ccl-target-dispatch)
(defvar *sources* nil)
(defvar *trace* nil)
(defvar *phase* "dumplisp")
(defvar *mode* "normal")
(defvar *cached* nil)
(defvar *throw-tag* nil)
(defun obj (&rest xs) (apply #'ccl-target-helpers::obj xs))
(defun bool (x) (ccl-target-helpers::bool x))
(defun field (x key) (ccl-source-traversal::field x key))
(defun syntax (x) (ccl-source-expanders::syntax x))
(defun ident (x) (if x (ccl-source-expanders::ident x) :null))
(defun label (x) (ccl-source-expanders::label x))
(defun event () (if (equal *phase* "dumplisp") (1- ccl-source-expanders::*next-event*) :null))
(defun source (path name package)
  (ccl-census-stub::with-target-state
   (lambda ()
    (let* ((text (ccl-source-traversal::source-text
                  (merge-pathnames path (pathname (concatenate 'string (ccl:getenv "CCL_DEFAULT_DIRECTORY") "/")))))
           (marker (concatenate 'string "(defun " name " ")) (start (search marker text))
           (*package* (find-package package)) (*read-eval* nil))
      (unless (and start (not (search marker text :start2 (1+ start)))) (error "DISPATCH-SOURCE-UNIQUE"))
      (multiple-value-bind (form end) (read-from-string text t nil :start start)
        (unless (eq (second form) (find-symbol (string-upcase name) package)) (error "DISPATCH-SOURCE-NAME"))
        (push (obj "path" path "start" start "end" end "text" (subseq text start end)
                   "package" package "reader" (ccl-source-traversal::context) "form" (syntax form)) *sources*)
        form)))))
(defun invoke (fn form env)
  (let ((completed nil) (answer nil))
    (unwind-protect
      (progn (setf answer (multiple-value-list (funcall fn form env)) completed t)
        (if (equal *mode* "discard-values") (first answer) (values-list answer)))
      (push (obj "kind" "call" "phase" *phase* "event" (event) "function_id" (ident fn)
                 "input" (syntax form) "environment_id" (ident env)
                 "status" (if completed "RETURNED" "ESCAPED")
                 "values" (if completed (mapcar #'syntax answer) :null)) *trace*))))
(defun build ()
  (let* ((dispatch (source "compiler/backend.lisp" "backend-arch-macroexpand" "CCL"))
         (lookup (source "compiler/arch.lisp" "arch-macro-function" "ARCH"))
         (table (source "compiler/arch.lisp" "target-arch-macros" "ARCH"))
         (find (source "compiler/arch.lisp" "find-target-arch" "ARCH"))
         (site '(funcall ccl::expander ccl::whole ccl::env)) (matches 0))
    (labels ((rewrite (x)
               (cond ((equal x site) (incf matches) '(invoke ccl::expander ccl::whole ccl::env))
                     ((consp x) (cons (rewrite (car x)) (rewrite (cdr x)))) (t x))))
      (let* ((dispatch-local (rewrite (cdr dispatch)))
             (lookup-local (copy-tree (cdr lookup)))
             (body (cddr lookup-local)))
        (unless (= matches 1) (error "DISPATCH-COMPUTED-SITE"))
        ;; The original gethash body executes inside the private source-derived
        ;; table/find chain. Mutations are probe-only; normal preserves values.
        (setf (cddr lookup-local)
         `((let ((arch::arch-name (if (equal *mode* "host-selector")
                                    (ccl::backend-target-arch-name ccl::*host-backend*) arch::arch-name)))
             (multiple-value-bind (fn present) (progn ,@body)
               (let* ((arch (arch::find-target-arch arch::arch-name))
                      (table (arch::target-arch-macros arch::arch-name)))
                 (push (obj "kind" "lookup" "phase" *phase* "event" (event)
                            "architecture" (label arch::arch-name) "architecture_id" (ident arch)
                            "table_id" (ident table) "operator" (label arch::name)
                            "function_id" (ident fn) "present" (bool present)) *trace*)
                 (cond ((and (equal *mode* "host-fallback") (not fn))
                        (arch::arch-macro-function (ccl::backend-target-arch-name ccl::*host-backend*) arch::name))
                       ((equal *mode* "cached-expander")
                        (values (or *cached* (setf *cached* fn)) present))
                       (t (values fn present))))))))
        (ccl-census-macros::native-function
         `(lambda (form env)
            (labels (,(cdr find) ,(cdr table) ,lookup-local ,dispatch-local)
              (ccl::backend-arch-macroexpand form env))))))))
(defun replacement (form env)
  (declare (ignore form env)) (values '(quote :replacement) :second :third))
(defun escaping (form env) (declare (ignore form env)) (throw *throw-tag* :escaped))
(defun probe (name fn form env)
  (let ((*phase* name) (answer nil) (problem nil) (status "RETURNED"))
    (handler-case (setf answer (multiple-value-list (funcall fn form env)))
      (error (e) (setf problem (princ-to-string e) status "ERROR")))
    (obj "name" name "input" (syntax form) "environment_id" (ident env)
         "status" status "values" (if problem :null (mapcar #'syntax answer)) "problem" (or problem :null))))
(defun probes (fn)
  (let ((rows nil) (metadata nil) (*cached* nil) (*throw-tag* (gensym)))
    (ccl-census-descriptions::with-descriptions
     (lambda ()
      (ccl-census-stub::with-target-state
       (lambda ()
        (let* ((original-arch wasm-census::*census-arch*)
               (original-table (arch::target-target-macros original-arch))
               (arch (arch::copy-target-arch original-arch)) (table (make-hash-table :test #'eq))
               (arch::*known-target-archs* (cons arch (remove original-arch arch::*known-target-archs*)))
               (op 'ccl::%get-kernel-global) (pointer 'ccl::%get-kernel-global-ptr)
               (batch '(ccl::%get-kernel-global 'ccl::batch-flag))
               (env (list :probe-environment)) (original (gethash op original-table)))
          (maphash (lambda (k v) (setf (gethash k table) v)) original-table)
          (setf (arch::target-target-macros arch) table)
          (setf metadata (obj "architecture" (label (arch::target-name arch))
            "architecture_id" (ident arch) "table_id" (ident table) "original_id" (ident original)
            "replacement_id" (ident #'replacement) "escaping_id" (ident #'escaping)
            "environment_id" (ident env) "host_architecture" (label (ccl::backend-target-arch-name ccl::*host-backend*))
            "host_batch_id" (ident (arch::arch-macro-function (ccl::backend-target-arch-name ccl::*host-backend*) op))
            "host_pointer_id" (ident (arch::arch-macro-function (ccl::backend-target-arch-name ccl::*host-backend*) pointer))))
          (push (probe "original" fn batch env) rows)
          (setf (gethash op table) #'replacement)
          (push (probe "replacement" fn batch env) rows)
          (remhash op table)
          (push (probe "absent" fn batch env) rows)
          (setf (gethash op table) nil)
          (push (probe "present-nil" fn batch env) rows)
          (setf (gethash op table) original)
          (push (probe "restored" fn batch env) rows)
          (push (probe "pointer-absent" fn '(ccl::%get-kernel-global-ptr 'ccl::batch-flag) env) rows)
          (let ((arch::*known-target-archs* (remove arch arch::*known-target-archs*)))
            (push (probe "architecture-absent" fn batch env) rows))
          (let ((*phase* "nonlocal") (completed nil) (answer nil))
            (setf (gethash op table) #'escaping)
            (unwind-protect
              (setf answer (catch *throw-tag* (funcall fn batch env) (setf completed t)))
              (setf (gethash op table) original))
            (push (obj "name" "nonlocal" "escaped" (bool (and (not completed) (eq answer :escaped)))
                       "binding_restored" (bool (eq (gethash op table) original))) rows))
          (push (probe "after-nonlocal" fn batch env) rows)
          (unless (and (eq (arch::target-target-macros original-arch) original-table)
                       (eq (gethash op original-table) original)
                       (not (gethash pointer original-table))) (error "DISPATCH-ORIGINAL-TABLE")))))))
    (values (nreverse rows) metadata)))
(defun file-registry ()
  (ccl-census-descriptions::with-descriptions
   (lambda ()
    (let* ((arch wasm-census::*census-arch*) (table (arch::target-target-macros arch)))
      (obj "architecture" (label (arch::target-name arch)) "architecture_id" (ident arch)
           "table_id" (ident table) "original_id" (ident (gethash 'ccl::%get-kernel-global table))
           "batch_is_description" (bool (eq (gethash 'ccl::%get-kernel-global table) #'ccl-census-descriptions::batch-flag-expander))
           "pointer_id" (ident (gethash 'ccl::%get-kernel-global-ptr table))
           "pointer_present" (bool (nth-value 1 (gethash 'ccl::%get-kernel-global-ptr table)))
           "registered" (bool (eq arch (arch::find-target-arch (arch::target-name arch)))))))))
(defun run ()
  (let ((*sources* nil) (*trace* nil) (*phase* "dumplisp") (*mode* "normal") (ccl-census-macros::*sources* nil) (ccl-census-macros::*registry* nil)
        (ccl-source-expanders::*registry* nil) (ccl-source-expanders::*compiled* nil)
        (ccl-source-expanders::*events* nil) (ccl-source-expanders::*next-event* 0)
        (ccl-source-expanders::*literals* nil) (ccl-target-helpers::*sources* nil)
        (ccl-target-helpers::*calls* nil) (ccl-target-types::*trace* nil) (ccl-target-predicates::*trace* nil)
        (ccl-target-aliases::*trace* nil) (ccl-target-aliases::*aliases* nil)
        (ccl-target-predicates::*mode* "normal") (ccl-target-aliases::*mode* "normal")
        (before (ccl-source-traversal::state)) (old-hook *macroexpand-hook*)
        (old-p2 (ccl::backend-p2-compile ccl::*host-backend*))
        (names '(ccl::backend-arch-macroexpand arch::arch-macro-function arch::target-arch-macros arch::find-target-arch typep ccl::specifier-type-if-known ccl::optimize-typep ccl::optimize-ctypep ccl::nx-target-type)))
   (let ((globals (mapcar #'fdefinition names)))
    (ccl-source-expanders::prepare)
    (dolist (r (reverse ccl-source-expanders::*registry*)) (ccl-target-helpers::ident (third r)) (ccl-target-helpers::ident (fourth r)))
    (flet ((source (path name) (ccl-target-helpers::read-form path name)))
     (let* ((helper (source "compiler/optimizers.lisp" "defun eql-iff-eq-p"))
            (range (source "compiler/nx0.lisp" "defun nx1-target-fixnump"))
            (eql-form (source "compiler/optimizers.lisp" "define-compiler-macro eql"))
            (typep-form (source "compiler/nx0.lisp" "defun nx-form-typep"))
            (form-type (source "compiler/nx0.lisp" "defun nx-form-type"))
            (target-type (source "compiler/nx-basic.lisp" "defun nx-target-type"))
            (lookup (source "compiler/nx0.lisp" "defun nx-lookup-target-uvector-subtag"))
            (stream (source "compiler/optimizers.lisp" "define-compiler-macro basic-stream-p"))
            (vector (source "compiler/optimizers.lisp" "define-compiler-macro vectorp"))
            (macro (source "compiler/optimizers.lisp" "define-compiler-macro typep"))
            (optimizer (source "compiler/optimizers.lisp" "defun optimize-typep"))
            (entry (ccl-target-helpers::compiler-entry 'typep)) (compiled nil) (dispatcher nil) (file-registry nil))
       (ccl-source-expanders::with-compiler-observation
        (lambda ()
         (setf (third (ccl-target-helpers::compiler-entry 'eql))
               (ccl-target-types::build helper range eql-form typep-form form-type target-type "normal")
               (third (ccl-target-helpers::compiler-entry 'ccl::basic-stream-p)) (ccl-target-helpers::build-stream lookup stream)
               (third (ccl-target-helpers::compiler-entry 'vectorp)) (ccl-target-helpers::build-stream lookup vector)
               compiled (ccl-target-aliases::build macro optimizer target-type)
               (third entry) compiled
               dispatcher (build))))
       (dolist (r ccl-source-expanders::*registry*)
         (when (equal (second r) "architecture-dispatch") (setf (third r) dispatcher)))
       (setf file-registry (file-registry))
       (let ((ccl-target-predicates::*phase* "dumplisp")) (ccl-source-expanders::with-routing #'ccl-census-descriptions::run))
       (let* ((file-trace (reverse *trace*))
              (file-events (sort (copy-list ccl-source-expanders::*events*) #'< :key (lambda (e) (field e "sequence"))))
              (*trace* nil) (*mode* (or (ccl:getenv "CCL_DISPATCH_MODE") "normal")))
         (multiple-value-bind (rows metadata) (probes dispatcher)
          (multiple-value-bind (reference-rows reference-metadata)
              (let ((*mode* "normal") (*trace* nil)) (probes (fdefinition 'ccl::backend-arch-macroexpand)))
           (unless (and (equal before (ccl-source-traversal::state)) (eq old-hook *macroexpand-hook*)
                        (eq old-p2 (ccl::backend-p2-compile ccl::*host-backend*))
                        (every #'eq globals (mapcar #'fdefinition names))) (error "DISPATCH-STATE-NOT-RESTORED"))
           (with-open-file (out (ccl:getenv "CCL_DISPATCH_OUTPUT") :direction :output :if-exists :error :external-format :utf-8)
             (ccl-startup-census::json
              (obj "version" 1 "sources" (reverse *sources*) "selected_id" (ident dispatcher)
                   "compiled" (cdr (assoc dispatcher ccl-source-expanders::*compiled* :test #'eq))
                   "events" file-events "file_registry" file-registry "file_trace" file-trace "probe_registry" metadata
                   "reference_probes" reference-rows "reference_registry" reference-metadata
                   "probes" rows "probe_trace" (reverse *trace*) "restored" :true
                   "macro_environment_qualified" :false "graph_edges_replaced" 0) out) (terpri out))))))))))
