{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Web UI Conformance Report v1",
  "type": "object",
  "required": [
    "version",
    "runId",
    "ts",
    "env",
    "summary",
    "fixtures"
  ],
  "properties": {
    "version": { "type": "string", "const": "1.0.0" },
    "runId": { "type": "string", "minLength": 1 },
    "ts": { "type": "integer", "minimum": 0 },
    "env": {
      "type": "object",
      "required": [
        "seed",
        "mode",
        "backend",
        "fontFallback",
        "engine",
        "engineVersion",
        "os",
        "osVersion",
        "gpu",
        "buildSha",
        "artifactHash"
      ],
      "properties": {
        "seed": { "type": "string", "minLength": 1 },
        "mode": {
          "type": "string",
          "enum": ["dark", "light", "high-contrast", "forced-colors", "mixed"]
        },
        "backend": { "type": "string", "enum": ["dom", "canvas", "webgl", "mixed"] },
        "fontFallback": { "type": "boolean" },
        "engine": { "type": "string", "minLength": 1 },
        "engineVersion": { "type": "string", "minLength": 1 },
        "os": { "type": "string", "minLength": 1 },
        "osVersion": { "type": "string", "minLength": 1 },
        "gpu": { "type": "string", "minLength": 1 },
        "buildSha": { "type": "string", "pattern": "^[0-9a-fA-F]{7,64}$" },
        "artifactHash": { "type": "string", "pattern": "^sha256:[0-9a-fA-F]{64}$" },
        "viewport": {
          "type": "object",
          "required": ["width", "height", "deviceScaleFactor"],
          "properties": {
            "width": { "type": "integer", "minimum": 1 },
            "height": { "type": "integer", "minimum": 1 },
            "deviceScaleFactor": { "type": "number", "exclusiveMinimum": 0 }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "summary": {
      "type": "object",
      "required": ["status", "fixtureCount", "passed", "failed"],
      "properties": {
        "status": { "type": "string", "enum": ["passed", "failed"] },
        "fixtureCount": { "type": "integer", "minimum": 0 },
        "passed": { "type": "integer", "minimum": 0 },
        "failed": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "fixtures": {
      "type": "array",
      "items": { "$ref": "#/$defs/fixtureResult" }
    }
  },
  "$defs": {
    "fixtureResult": {
      "type": "object",
      "required": [
        "id",
        "status",
        "durationMs",
        "assertions"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "status": { "type": "string", "enum": ["passed", "failed", "skipped"] },
        "durationMs": { "type": "number", "minimum": 0 },
        "binding": {
          "type": "object",
          "required": ["testPath"],
          "properties": {
            "testPath": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": false
        },
        "assertions": {
          "type": "array",
          "items": { "$ref": "#/$defs/assertionResult" }
        },
        "artifacts": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "diagnostics": {
          "type": "array",
          "items": { "$ref": "#/$defs/diagnostic" }
        }
      },
      "additionalProperties": false
    },
    "assertionResult": {
      "type": "object",
      "required": ["id", "status", "metric", "comparator", "expected", "actual"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "status": { "type": "string", "enum": ["passed", "failed"] },
        "metric": { "type": "string", "minLength": 1 },
        "comparator": { "type": "string", "minLength": 1 },
        "expected": {},
        "actual": {},
        "tolerance": {}
      },
      "additionalProperties": false
    },
    "diagnostic": {
      "type": "object",
      "required": ["code", "message"],
      "properties": {
        "code": { "type": "string", "minLength": 1 },
        "message": { "type": "string", "minLength": 1 },
        "details": {}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
