{
  "metadata": {
    "id": "web-ui.visual-tokens",
    "version": "1.0.0",
    "status": "draft",
    "lastUpdated": "2026-02-16",
    "compatibility": {
      "backward": "Minor versions MUST remain backward compatible for existing token keys.",
      "forward": "Unknown token keys MUST be ignored by consumers.",
      "deprecation": "Deprecated keys MUST remain for one major version before removal."
    }
  },
  "units": {
    "color": "rgba-8",
    "spacing": "px",
    "radius": "px",
    "fontSize": "px",
    "fontWeight": "numeric",
    "lineHeight": "unitless",
    "letterSpacing": "em",
    "duration": "ms",
    "easing": "cubic-bezier",
    "elevation": "px+alpha"
  },
  "constraints": {
    "elevationLevelsMin": 2,
    "elevationLevelsMax": 4,
    "requiredModes": ["dark", "light", "high-contrast", "forced-colors"],
    "focusRingWidthPx": {
