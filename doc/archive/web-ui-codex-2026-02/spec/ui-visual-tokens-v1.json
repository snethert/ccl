    "touchTargetPx": {
      "min": 44,
      "max": 64
    },
    "motionDurationMs": {
      "min": 80,
      "max": 300
    },
    "accessibilityThresholds": {
      "textNormalContrastMin": 4.5,
      "textLargeContrastMin": 3.0,
      "nonTextContrastMin": 3.0
    },
    "boundaryRolesRequired": ["subtle", "standard", "strong", "focus"]
  },
