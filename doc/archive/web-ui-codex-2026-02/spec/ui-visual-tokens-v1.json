  "space": {
    "xs": 4,
    "sm": 8,
    "md": 12,
    "lg": 16,
    "xl": 24,
    "xxl": 32
  },
  "radius": {
    "xs": 3,
    "sm": 4,
    "md": 8,
    "lg": 12
  },
  "typography": {
    "family": {
      "body": "Inter",
      "bodyFallbackStack": [
        "Inter",
        "Segoe UI",
        "Roboto",
        "Noto Sans",
        "Helvetica Neue",
        "Arial",
        "sans-serif"
      ],
      "mono": "Iosevka",
      "monoFallbackStack": [
        "Iosevka",
        "SFMono-Regular",
        "Consolas",
        "Menlo",
        "Liberation Mono",
        "monospace"
      ]
    },
    "scriptCoverage": {
      "requiredScripts": [
        "Latin",
        "Cyrillic",
        "Greek",
        "Arabic",
        "Hebrew",
        "Devanagari",
        "Han",
        "Kana"
      ],
      "bodyFallbackByScript": {
        "Latin": ["Inter", "Segoe UI", "Roboto", "Noto Sans", "Arial", "sans-serif"],
        "Cyrillic": ["Inter", "Noto Sans", "Segoe UI", "Arial", "sans-serif"],
        "Greek": ["Inter", "Noto Sans", "Segoe UI", "Arial", "sans-serif"],
        "Arabic": [
          "Noto Naskh Arabic",
          "Noto Sans Arabic",
          "Segoe UI",
          "Tahoma",
          "sans-serif"
        ],
        "Hebrew": ["Noto Sans Hebrew", "Segoe UI", "Arial", "sans-serif"],
        "Devanagari": [
          "Noto Sans Devanagari",
          "Mangal",
          "Kohinoor Devanagari",
          "sans-serif"
        ],
        "Han": ["Noto Sans CJK SC", "PingFang SC", "Microsoft YaHei", "sans-serif"],
        "Kana": ["Noto Sans CJK JP", "Hiragino Kaku Gothic ProN", "Yu Gothic", "sans-serif"]
      },
      "monoFallbackByScript": {
        "Latin": ["Iosevka", "SFMono-Regular", "Consolas", "Menlo", "monospace"],
        "Cyrillic": ["Iosevka", "Cascadia Mono", "Consolas", "monospace"],
        "Greek": ["Iosevka", "Cascadia Mono", "Consolas", "monospace"],
        "Arabic": ["Noto Sans Mono", "monospace"],
        "Hebrew": ["Noto Sans Mono", "monospace"],
        "Devanagari": ["Noto Sans Mono", "monospace"],
        "Han": ["Noto Sans Mono CJK SC", "Sarasa Mono SC", "monospace"],
        "Kana": ["Noto Sans Mono CJK JP", "Sarasa Mono J", "monospace"]
      }
    },
    "directionality": {
      "default": "ltr",
      "rtlLocales": ["ar", "fa", "he", "ur"],
      "layoutStrategy": "logical-properties",
      "mirrorDirectionalIcons": true,
      "bidiIsolationRequired": true
    },
    "localeOverrides": {
      "ja-JP": {
        "bodyFallbackStack": [
          "Noto Sans CJK JP",
          "Hiragino Kaku Gothic ProN",
          "Yu Gothic",
          "sans-serif"
        ],
        "lineHeight": "relaxed",
        "letterSpacingMultiplier": 0.8
      },
      "zh-CN": {
        "bodyFallbackStack": [
          "Noto Sans CJK SC",
          "PingFang SC",
          "Microsoft YaHei",
          "sans-serif"
        ],
        "lineHeight": "normal",
        "letterSpacingMultiplier": 0.9
      },
      "ko-KR": {
        "bodyFallbackStack": [
          "Noto Sans CJK KR",
          "Apple SD Gothic Neo",
          "Malgun Gothic",
          "sans-serif"
        ],
        "lineHeight": "normal",
        "letterSpacingMultiplier": 0.9
      },
      "ar": {
        "bodyFallbackStack": [
          "Noto Naskh Arabic",
          "Noto Sans Arabic",
          "Segoe UI",
          "Tahoma",
          "sans-serif"
        ],
        "lineHeight": "relaxed",
        "letterSpacingMultiplier": 0
      }
    },
    "size": {
      "xs": 11,
      "sm": 12,
      "md": 14,
      "lg": 16,
      "xl": 20,
      "xxl": 24
    },
    "weight": {
      "regular": 400,
      "medium": 500,
      "bold": 600
    },
    "lineHeight": {
      "tight": 1.2,
      "normal": 1.4,
      "relaxed": 1.6
    },
    "letterSpacing": {
      "default": 0.005,
      "labelCaps": 0.04
    }
  },
  "motion": {
    "durationMs": {
      "fast": 120,
      "normal": 180,
      "slow": 250
    },
    "easing": {
      "standard": [0.2, 0.0, 0.2, 1.0],
      "emphasis": [0.1, 0.0, 0.0, 1.0]
    },
    "reduced": {
      "durationMs": 0,
      "allowOpacityTransition": true
    }
  },
  "elevation": {
    "level1": { "x": 0, "y": 1, "blur": 4, "spread": 0, "alpha": 0.25 },
    "level2": { "x": 0, "y": 2, "blur": 8, "spread": 0, "alpha": 0.25 },
    "level3": { "x": 0, "y": 4, "blur": 12, "spread": 0, "alpha": 0.28 },
    "level4": { "x": 0, "y": 8, "blur": 20, "spread": 0, "alpha": 0.3 }
  },
  "focus": {
    "ringWidthPx": 2,
    "ringOffsetPx": 1,
    "ringStyle": "solid"
  },
  "deprecated": []
}
